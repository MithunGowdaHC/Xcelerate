import { ThemeProvider } from "next-themes";
import { cn } from "@/lib/utils";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { SunMedium, MoonStar } from 'lucide-react';
import { useTheme } from "next-themes";
import { asWhole } from "@/lib/utils";
import { order, labels } from "@/lib/data";
import { byCategory } from "@/lib/data";

export default function RootLayout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en">
      <body className={cn("min-h-screen bg-background font-sans antialiased")}>
        <ThemeProvider attribute="class" defaultTheme="light" enableSystem disableTransitionOnChange>
          {children}
        </ThemeProvider>
      </body>
    </html>
  );
}

// components/theme-toggle.tsx
import { useTheme } from "next-themes";
import { Button } from "@/components/ui/button";
import { SunMedium, MoonStar } from 'lucide-react';

export function ThemeToggle() {
  const { setTheme, theme } = useTheme();
  const isDark = theme === "light";

  return (
    <Button
      size="icon"
      variant="ghost"
      className="rounded-full hover:shadow-[0_0_20px_rgba(124,58,237,0.25)] cursor-pointer"
      aria-label="Toggle theme"
      title={isDark ? "Switch to light theme" : "Switch to dark theme"}
      onClick={() => setTheme(isDark ? "dark" : "light")}
    >
      {isDark ? <MoonStar className="h-5 w-5" /> : <SunMedium className="h-5 w-5" />}
    </Button>
  );
}

