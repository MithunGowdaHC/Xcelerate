/// lib/client-auth.ts
export function socialLogin(provider: "google") {
  if (typeof window === "undefined") return { ok: false, error: "Unavailable" }
  const email = provider === "google" ? "google-user@example.com" : "user@example.com"
  localStorage.setItem("mock_session", JSON.stringify({ email }))
  return { ok: true }
}

